<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <GeneDef Name="GeneDef_Cheech_FurPatternFill" Abstract="True">
    <geneClass>Cheechin.GeneFurPatternFill</geneClass>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>
    <!--<endogeneCategory>Melanin</endogeneCategory>-->
    <displayCategory>GeneCategoryDef_Cheech_FurPatternFill</displayCategory>
    <description>Lower-layer, larger markings like patches or shading.</description>
    <displayOrderInCategory>100</displayOrderInCategory>
    <iconColor>(0.75,0.75,0.75)</iconColor>
    <iconPath>Cheech/Icons/Icon_FurTufts</iconPath>
    <randomChosen>true</randomChosen>
    <selectionWeight>0.1</selectionWeight>
    <exclusionTags>
      <li>FurPatternFill</li>
    </exclusionTags>
    <renderNodeProperties>
      <li>
        <nodeClass>Cheechin.PawnRenderNode_FurPatternFill</nodeClass>
        <workerClass>PawnRenderNodeWorker_Body</workerClass>
        <baseLayer>5.2</baseLayer>
        <colorType>Custom</colorType>
        <parentTagDef>Body</parentTagDef>
        <rotDrawMode>Fresh,Rotting</rotDrawMode>
        <useRottenColor>true</useRottenColor>
        <debugLabel>Fur Pattern Fill</debugLabel>
      </li>
    </renderNodeProperties>
    <modExtensions>
      <li Class="Cheechin.FurPatternColors">
        <predefinedFurPatternColors>
          <li>Cheechin_FurPreset_Black</li>
        </predefinedFurPatternColors>
      </li>
    </modExtensions>
  </GeneDef>

