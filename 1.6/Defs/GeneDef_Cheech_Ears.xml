  <GeneDef ParentName="GeneDef_Cheech_Ears_Average_GreyFill">
    <defName>GeneDef_Cheech_Ears_Average_GreyFill_Striped</defName>
    <label>cheech ears</label>
    <description>Cosmetic only. Average size Cheech ears with stripes.</description>
    <renderNodeProperties>
      <li Class="Cheechin.PawnRenderNodeProperties_EarsWithPattern">
        <maskPath>Cheech/Ears/m/Cheech_Ears_Average_Striped</maskPath>
      </li>
    </renderNodeProperties>
    <modExtensions>
      <li Class="Cheechin.FurPatternColors">
        <predefinedFurPatternColors>
          <li>Cheechin_FurPreset_BrownTwo</li>
        </predefinedFurPatternColors>
      </li>
    </modExtensions>
  </GeneDef>

