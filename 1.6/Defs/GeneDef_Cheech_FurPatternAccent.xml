<Defs>

  <Cheechin.FurColorDef>
    <defName>Cheechin_FurPreset_Black</defName>
    <primaryColor>(0,0,0)</primaryColor>
    <secondaryColor>(255,255,255)</secondaryColor>
    <selectionWeight>0.63</selectionWeight>
  </Cheechin.FurColorDef>

  <GeneDef Name="GeneDef_Cheech_FurPatternAccent" Abstract="True">
    <geneClass>Cheechin.GeneFurPatternAccent</geneClass>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayCategory>GeneCategoryDef_Cheech_FurPatternAccent</displayCategory>
    <description>Finer detail markings like stripes or spots.</description>
    <displayOrderInCategory>100</displayOrderInCategory>
    <iconColor>(0.75,0.75,0.75)</iconColor>
    <iconPath>Cheech/Icons/Icon_FurTufts</iconPath>
    <exclusionTags>
      <li>FurPatternAccent</li>
    </exclusionTags>
    <renderNodeProperties>
      <li>
        <nodeClass>Cheechin.PawnRenderNode_FurPatternAccent</nodeClass>
        <workerClass>PawnRenderNodeWorker_Body</workerClass>
        <baseLayer>7</baseLayer>
        <colorType>Custom</colorType>
        <parentTagDef>Body</parentTagDef>
        <rotDrawMode>Fresh,Rotting</rotDrawMode>
        <useRottenColor>true</useRottenColor>
        <debugLabel>Fur Pattern Accent</debugLabel>
      </li>
    </renderNodeProperties>
    <modExtensions>
      <li Class="Cheechin.FurColors">
        <allowedFurColors>
          <li>Cheechin_FurPreset_Black</li>
        </allowedFurColors>
      </li>
    </modExtensions>
  </GeneDef>

