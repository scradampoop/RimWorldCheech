	</GeneDef>

	<!--
	Bobtail OUTLINE abstract: the greyscale Bob_Tail texture. The stub has no hidden "stem" to tuck behind the body, so its open (unoutlined) root edge has to sit right on the rump:
	- East/West: root edge placed ~0.04 inside the rear edge of the Female body silhouette at rump height (z ≈ -0.31); layer -2 hides the seam.
	- North: drawn over the lower back (layer 90), root at z ≈ -0.24.
	- South: same spot behind the body, so it's hidden from the front (like a real bobtail). To make it peek out, raise/shift dataSouth.
	bodyTypeOffsets follow each body type's rear edge / rump height relative to Female (measured from the Tufts body textures), not Cheechy's values, since a stub can't hide a gap.
	-->
	<GeneDef Name="GeneDef_Cheech_Tail_Bob" ParentName="GeneTailBase" Abstract="True">
		<geneClass>Cheechin.GeneTailWithPattern</geneClass>
		<iconPath>Cheech/Icons/Icon_Paw</iconPath>
		<biostatCpx>0</biostatCpx>
		<biostatMet>0</biostatMet>
		<displayOrderInCategory>1000</displayOrderInCategory>
		<renderNodeProperties>
			<li Class="Cheechin.PawnRenderNodeProperties_BodyTypeOffsets">
				<nodeClass>Cheechin.PawnRenderNode_TailWithPattern</nodeClass>
				<workerClass>Cheechin.PawnRenderNodeWorker_AttachmentBodyType</workerClass>
				<texPath>Cheech/Tail/Bob_Tail</texPath>
				<colorType>Custom</colorType>
				<overrideMeshSize>(1, 1)</overrideMeshSize>
				<parentTagDef>Body</parentTagDef>
				<useRottenColor>true</useRottenColor>
				<rotDrawMode>Fresh,Rotting</rotDrawMode>
				<drawData>
					<scaleOffsetByBodySize>true</scaleOffsetByBodySize>
					<defaultData>
						<layer>-2</layer>
					</defaultData>
					<dataNorth>
						<offset>(-0.03,0,-0.63)</offset>
						<layer>90</layer>
					</dataNorth>
					<dataSouth>
						<offset>(0.03,0,-0.63)</offset>
					</dataSouth>
					<dataEast>
						<offset>(-0.62,0,-0.52)</offset>
					</dataEast>
					<dataWest>
						<offset>(0.62,0,-0.52)</offset>
					</dataWest>
				</drawData>
				<bodyTypeOffsets>
					<li>
						<bodyType>Male</bodyType>
						<offset>(0.1, 0, -0.05)</offset>
					</li>
					<li>
						<bodyType>Fat</bodyType>
						<offset>(0, 0, 0.05)</offset>
					</li>
					<li>
						<bodyType>Hulk</bodyType>
						<offset>(-0.05, 0, -0.1)</offset>
					</li>
					<li>
						<bodyType>Thin</bodyType>
						<offset>(0, 0, -0.1)</offset>
					</li>
				</bodyTypeOffsets>
			</li>
		</renderNodeProperties>
	</GeneDef>

	<GeneDef ParentName="GeneDef_Cheech_Tail_Bob">
