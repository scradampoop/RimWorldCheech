<?xml version="1.0" encoding="UTF-8"?>
<Defs>
	<GeneDef Name="GeneDef_Cheech_Tail" ParentName="GeneTailBase" Abstract="True">
		<!--Inherited:
		<displayCategory>Miscellaneous</displayCategory>
		<randomChosen>true</randomChosen>
		<exclusionTags>
			<li>Tail</li>
		</exclusionTags>-->
		<geneClass>Cheechin.GeneTailWithPattern</geneClass>
		<iconPath>Cheech/Icons/Icon_Paw</iconPath>
		<biostatCpx>0</biostatCpx>
		<biostatMet>0</biostatMet>
		<displayOrderInCategory>1000</displayOrderInCategory>
		<renderNodeProperties>
			<li Class="Cheechin.PawnRenderNodeProperties_BodyTypeOffsets">
				<nodeClass>Cheechin.PawnRenderNode_TailWithPattern</nodeClass>
				<workerClass>Cheechin.PawnRenderNodeWorker_AttachmentBodyType</workerClass>
				<texPath>Cheech/Tail/Cheech_Tail</texPath>
				<colorType>Custom</colorType>
				<overrideMeshSize>(1, 1)</overrideMeshSize>
				<parentTagDef>Body</parentTagDef>
				<useRottenColor>true</useRottenColor>
				<rotDrawMode>Fresh,Rotting</rotDrawMode>
				<!--<visibleFacing>
					<li>East</li>
					<li>North</li>
					<li>West</li>
				</visibleFacing>
Notes/example for changing offsets:
dataNorth/dataSouth (0, 0, -0.25) — no horizontal shift, pushed down 0.25 cells.
dataEast (-0.55, 0, -0.25) — shifted 0.55 cells left and 0.25 down (tail hanging off the pawn's left side when they face east).
dataWest (0.55, 0, -0.25) — mirrored: 0.55 right, 0.25 down.
				-->
				<drawData>
					<scaleOffsetByBodySize>true</scaleOffsetByBodySize>
					<defaultData>
						<layer>-2</layer>
					</defaultData>
					<dataNorth>
						<offset>(0,0,-0.22)</offset>
						<layer>90</layer>
					</dataNorth>
					<dataSouth>
						<offset>(0,0,-0.12)</offset>
						<!--<layer>90</layer>-->
					</dataSouth>
					<dataEast>
						<offset>(-0.5,0,-0.23)</offset>
					</dataEast>
					<dataWest>
						<offset>(0.5,0,-0.23)</offset>
					</dataWest>
				</drawData>
				<!--
				Per-body-type attach-point corrections, added on top of drawData above. <offset> nudges all facings. +Z is up, +X is right. Tune one body type at a time in-game with the DEV: Fur Colors pawn.
				-->
				<bodyTypeOffsets>
					<li>
						<bodyType>Male</bodyType>
						<offset>(0.05, 0, 0.04)</offset>
					</li>
					<li>
						<bodyType>Fat</bodyType>
						<offset>(-0.03, 0, 0.08)</offset>
					</li>
					<li>
						<bodyType>Hulk</bodyType>
						<offset>(-0.1, 0, -0.03)</offset>
					</li>
				</bodyTypeOffsets>
			</li>
		</renderNodeProperties>
	</GeneDef>

	<GeneDef ParentName="GeneDef_Cheech_Tail">
		<defName>GeneDef_Cheech_Tail_Stripes</defName>
		<label>cheech tail</label>
		<description>Striped Cheech tail.  ^_^</description>
