	</GeneDef>

	<!--
	Cheechy tail OUTLINE abstract: the greyscale Cheechy_Tail texture. Independent of	GeneDef_Cheech_Tail — it extends the vanilla GeneTailBase directly (same convention	as the ear outlines),
	so it restates the Cheech scalar config (geneClass, icon,	biostats) and needs no Inherit="False" since GeneTailBase carries no render li.	Mask variants below ParentName this and just
	append a PatternMask li, so one outline can host many masks. drawData/bodyTypeOffsets mirror GeneDef_Cheech_Tail as a	starting point; tune in-game with the DEV: Fur Colors gizmo if needed.
	-->
	<GeneDef Name="GeneDef_Cheech_Tail_Cheechy" ParentName="GeneTailBase" Abstract="True">
		<geneClass>Cheechin.GeneTailWithPattern</geneClass>
		<iconPath>Cheech/Icons/Icon_Paw</iconPath>
		<biostatCpx>0</biostatCpx>
		<biostatMet>0</biostatMet>
		<displayOrderInCategory>1000</displayOrderInCategory>
		<renderNodeProperties>
			<li Class="Cheechin.PawnRenderNodeProperties_BodyTypeOffsets">
				<nodeClass>Cheechin.PawnRenderNode_TailWithPattern</nodeClass>
				<workerClass>Cheechin.PawnRenderNodeWorker_AttachmentBodyType</workerClass>
				<texPath>Cheech/Tail/Cheechy_Tail</texPath>
				<colorType>Custom</colorType>
				<overrideMeshSize>(1, 1)</overrideMeshSize>
				<parentTagDef>Body</parentTagDef>
				<useRottenColor>true</useRottenColor>
				<rotDrawMode>Fresh,Rotting</rotDrawMode>
				<drawData>
					<scaleOffsetByBodySize>true</scaleOffsetByBodySize>
					<defaultData>
						<layer>-2</layer>
					</defaultData>
					<dataNorth>
						<offset>(-0.03,0,-0.65)</offset>
						<layer>90</layer>
					</dataNorth>
					<dataSouth>
						<offset>(-0.03,0,-0.55)</offset>
					</dataSouth>
					<dataEast>
						<offset>(-0.55,0,-0.55)</offset>
					</dataEast>
					<dataWest>
						<offset>(0.55,0,-0.55)</offset>
					</dataWest>
				</drawData>
				<bodyTypeOffsets>
					<li>
						<bodyType>Male</bodyType>
						<offset>(0.05, 0, 0.04)</offset>
					</li>
					<li>
						<bodyType>Fat</bodyType>
						<offset>(-0.03, 0, 0.08)</offset>
					</li>
					<li>
						<bodyType>Hulk</bodyType>
						<offset>(-0.1, 0, -0.06)</offset>
					</li>
					<li>
						<bodyType>Thin</bodyType>
						<offset>(0, 0, -0.04)</offset>
					</li>
				</bodyTypeOffsets>
			</li>
		</renderNodeProperties>
	</GeneDef>

