					</dataEast>
					<dataWest>
						<offset>(0.53,0,-0.54)</offset>
					</dataWest>
				</drawData>
				<bodyTypeOffsets>
					<li>
						<bodyType>Male</bodyType>
						<offset>(0.05, 0, 0.02)</offset>
